# CoreFusion Panel Configuration
# Copy this file to .env and modify as needed.

# Data directory (required)
SAFE_PATHS=data

# ── Database Configuration ──────────────────────────────────
# CF_DB_DSN: Database connection string.
#   - Not set or bare path → SQLite (default, compatible with existing setups)
#   - "mysql://..."         → MySQL
#   - "postgres://..."      → PostgreSQL (also accepts "postgresql://")
#   - "sqlite://..."        → SQLite (explicit)
#
# CF_DB_TYPE: Optional type hint, overrides auto-detection from DSN scheme.
#   Values: sqlite | mysql | postgres

# ── SQLite (default) ────────────────────────────────────────
# Option 1: bare path (auto-detected as SQLite)
CF_DB_DSN=data/sqlite/app.db
# Option 2: explicit sqlite:// prefix
# CF_DB_DSN=sqlite:///opt/corefusion/data/sqlite/app.db

# ── MySQL ───────────────────────────────────────────────────
# DSN format: mysql://user:password@tcp(host:port)/dbname?params
# After stripping "mysql://", the remaining DSN follows Go's go-sql-driver format:
#   user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
# CF_DB_DSN=mysql://corefusion:password@tcp(127.0.0.1:3306)/corefusion?charset=utf8mb4&parseTime=True&loc=Local

# ── PostgreSQL ──────────────────────────────────────────────
# DSN format: postgres://user:password@host:port/dbname?params
# Uses the standard PostgreSQL connection URI format (pgx driver).
# CF_DB_DSN=postgres://corefusion:password@127.0.0.1:5432/corefusion?sslmode=disable

# ── Connection pool (optional, MySQL/PostgreSQL only) ──────
# CF_DB_MAX_OPEN_CONNS=100
# CF_DB_MAX_IDLE_CONNS=10

# ── Security ──────────────────────────────────────────────────
# CF_SECRET_ENCRYPTION_KEY: 64 hex chars (32 bytes). Used to encrypt
#   sensitive data (recharge card numbers, DNS credentials, etc.).
#   Auto-generated on first run if not set. Keep a backup!
# CF_SECRET_ENCRYPTION_KEY=

# JWT_SECRET: Secret key for signing login tokens.
#   Auto-generated on first run if not set.
# Regenerating forces all users to re-login.
# JWT_SECRET=

# ── Admin ─────────────────────────────────────────────────────
# CF_INITIAL_ADMIN_PASSWORD: Initial admin password.
#   If not set, a random password is generated and printed once.
# CF_INITIAL_ADMIN_PASSWORD=

# ── Network Traffic Accounting (optional) ─────────────────────
# CF_NETWORK_TRAFFIC_ACCOUNTING: Set to "0" to disable iptables-based
#   network traffic accounting. Default is enabled.
# CF_NETWORK_TRAFFIC_ACCOUNTING=1

# CF_NETWORK_TRAFFIC_TABLE: iptables table name for traffic accounting.
# CF_NETWORK_TRAFFIC_TABLE=corefusion
