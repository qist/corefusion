[Unit]
Description=CoreFusion Panel
Documentation=https://github.com/qist/corefusion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 数据库 DSN 为相对路径时依赖此工作目录，不要修改
WorkingDirectory=/opt/corefusion
ExecStart=/opt/corefusion/corefusion
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
KillSignal=SIGTERM
TimeoutStopSec=30
# 只杀主进程（面板），不回收整个 cgroup：核心（xray/sing-box）与代理
# （caddy/nginx）都是数据面服务，在面板重启/升级期间保持运行；新面板启动时
# 按 PID + 二进制 inode 校验后接管（adopt），流量不中断。
KillMode=process

# 日志使用 journald：
#   journalctl -u corefusion -f
# 如需写入文件，取消下面两行注释（目录需存在）
#StandardOutput=append:/var/log/corefusion.log
#StandardError=append:/var/log/corefusion.log

[Install]
WantedBy=multi-user.target
